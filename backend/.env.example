DATABASE_URL="postgresql://user:password@localhost:5432/mezan?schema=public"
JWT_SECRET="your-jwt-secret-change-in-production"
INGEST_TOKEN_SECRET="ingest-token-secret"
PORT=3000

# LLM categorization for SMS/ingest (optional; falls back to rule-based if unset)
